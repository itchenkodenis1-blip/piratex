# ============================================================================
# Piratex.ai — backend environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values:   cp .env.example .env
#
# Only the 3 vars in the REQUIRED block are needed to boot. Everything else is
# OPTIONAL — if a key is missing, the related feature is simply disabled and
# the app keeps running (no crash). Start minimal, add integrations later.
#
# Validate what you've set at any time:   python scripts/check_env.py
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------
# Signing key for auth tokens. Generate one:  openssl rand -hex 32
JWT_SECRET=

# PostgreSQL connection string. Managed Postgres (Railway/Render) provides this
# automatically -- just reference it. Local dev example shown below.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/piratex

# Redis -- task queue + realtime progress. Managed Redis provides this.
REDIS_URL=redis://localhost:6379

# --- AI / LLM  (need at least one provider for analysis to work) ------------
# OpenRouter -- primary provider for chat + vision.  https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenAI -- used only if OPENROUTER_API_KEY is empty.  https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (Claude) -- script & strategy generation.  https://console.anthropic.com
ANTHROPIC_API_KEY=
# Whisper transcription (audio->text). Groq has a free tier:  https://console.groq.com
# Falls back to the OpenRouter key if left empty.
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.groq.com/openai/v1

# Model names -- override only if you know what you're doing.
WHISPER_MODEL=whisper-large-v3-turbo
VISION_MODEL=openai/gpt-4o-mini
TEXT_MODEL=claude-sonnet-4-6
LIGHT_TEXT_MODEL=claude-haiku-4-5
FALLBACK_TEXT_MODEL=openai/gpt-4.1

# --- Scraping (Apify)  -- needed to analyze real IG / TikTok / YouTube -------
# Account token:  https://console.apify.com/account/integrations
APIFY_API_TOKEN=
APIFY_TIMEOUT=300
# Actor IDs -- public actors by default; override only if you use your own.
APIFY_INSTAGRAM_ACTOR=apify~instagram-reel-scraper
APIFY_YOUTUBE_ACTOR=dc_solutions~youtube-downloader-pro
APIFY_YOUTUBE_FALLBACK_ACTOR=marielise.dev~youtube-video-downloader
APIFY_TIKTOK_ACTOR=apidojo~tiktok-scraper
APIFY_TIKTOK_FALLBACK_ACTOR=clockworks~tiktok-scraper
APIFY_YOUTUBE_COMMENTS_ACTOR=streamers~youtube-comments-scraper
APIFY_TIKTOK_COMMENTS_ACTOR=clockworks~tiktok-comments-scraper
APIFY_INSTAGRAM_PROFILE_ACTOR=apify~instagram-profile-scraper
# Budget guardrails (% of your monthly Apify limit)
APIFY_BALANCE_MIN_PCT=5.0
APIFY_BALANCE_ALERT_PCT=20.0
APIFY_BALANCE_CHECK_INTERVAL=300

# --- Telegram (OPTIONAL)  -- bot login + channel-subscription gate ----------
# Create a bot with @BotFather to get the token. Empty = Telegram disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=your_bot_username
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_URL=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# --- Cloudflare Turnstile (OPTIONAL captcha)  -- empty = disabled -----------
# https://dash.cloudflare.com  ->  Turnstile.  Secret key here; the matching
# PUBLIC site key goes in frontend/.env.example (VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=

# --- OAuth logins (OPTIONAL)  -- each empty pair disables that provider -----
# Yandex ID:  https://oauth.yandex.ru/
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID:  https://id.vk.com/business/go
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# Google:  https://console.cloud.google.com/  (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (OPTIONAL)  -- magic-link login + notifications ------------------
# Unisender Go:  https://go.unisender.ru/   (empty = emails are logged, not sent)
UNISENDER_API_KEY=
EMAIL_FROM_DOMAIN=example.com
MAGIC_LINK_TTL_MINUTES=15

# --- Phone / SMS auth (OPTIONAL, currently unused) --------------------------
SMS_PROVIDER_API_KEY=
PHONE_CODE_TTL_MINUTES=5
PHONE_CODE_MAX_ATTEMPTS=3

# --- Object storage (OPTIONAL)  -- empty S3_BUCKET = local disk -------------
# Works with Cloudflare R2, AWS S3, Railway Buckets, MinIO.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_ADDRESSING_STYLE=
CDN_URL=
# Local disk path used when S3 is not configured. On Railway set this to the
# mounted volume path, e.g. /data/storage
STORAGE_DIR=./storage

# --- Payments (OPTIONAL)  -- configure whichever provider you need ----------
# YooKassa (RUB):  https://yookassa.ru/
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
# Stripe (EUR):  https://dashboard.stripe.com/apikeys
# Also paste your own Price IDs into backend/app/config.py -> STRIPE_PRICE_IDS
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# CloudPayments (RUB):  https://merchant.cloudpayments.ru/
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# --- App / admin ------------------------------------------------------------
APP_NAME=Piratex.ai
APP_URL=http://localhost:8002
# Comma-separated. These accounts get admin dashboards + alerts.
ADMIN_EMAILS=
ADMIN_TELEGRAM_IDS=

# --- Server / tuning (sane defaults -- safe to leave as-is) -----------------
DEBUG=false
DEMO_MODE=false
# Must include the public origin your frontend is served from (comma-separated).
CORS_ORIGINS=http://localhost:8002
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
MAX_VIDEO_DURATION_SECONDS=300
SCENE_DETECT_THRESHOLD=27.0
SAFETY_FRAME_INTERVAL=5.0
MAX_CONCURRENT_VISION_CALLS=10
MAX_CONCURRENT_FFMPEG=4
FAILED_JOB_RETENTION_DAYS=7
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# Web process count (start.sh). PORT is set automatically by Railway/Render.
UVICORN_WORKERS=2
