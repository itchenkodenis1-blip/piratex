# Frontend build-time variables (Vite). These ship inside the compiled JS
# bundle and are PUBLIC -- never put secrets here.
# In Docker they must be passed as build args (see Dockerfile + DEPLOY_RAILWAY.md).

# Cloudflare Turnstile PUBLIC site key (pairs with TURNSTILE_SECRET_KEY on the
# backend). Leave empty to disable the captcha widget.
# https://dash.cloudflare.com  ->  Turnstile
VITE_TURNSTILE_SITE_KEY=

# NOTE: brand name, legal entity, support email and Telegram links are NOT env
# vars -- edit them directly in frontend/src/region.ts before going live.

# Yandex.Metrika counter id (leave empty to disable analytics)
VITE_YANDEX_METRIKA_ID=
